rules_version = '2';
// Firestore for ReRoot Studio. The API (Cloud Run / Render, service account) writes with admin access;
// browsers only read the demo alert feed, and each anonymous user owns their own chat backups.
service cloud.firestore {
  match /databases/{database}/documents {
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if false;
    }
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
